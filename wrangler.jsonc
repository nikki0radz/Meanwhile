{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meanwhile",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "build": {"command": "node scripts/build.cjs"},
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "vars": {"AI_MODEL": "gpt-4.1-mini", "TRANSCRIPTION_MODEL": "gpt-transcribe"},
  "r2_buckets": [{"binding": "BACKUPS", "bucket_name": "meanwhile-backups"}],
  "ratelimits": [
    {"name": "LOGIN_LIMITER", "namespace_id": "21001", "simple": {"limit": 8, "period": 60}},
    {"name": "AI_LIMITER", "namespace_id": "21002", "simple": {"limit": 12, "period": 60}}
  ],
  "observability": {"enabled": false}
}
